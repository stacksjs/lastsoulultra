{
  "name": "last-soul-ultra",
  "type": "module",
  "version": "1.0.0-build.23",
  "private": true,
  "description": "Last Soul Ultra World Series and coaching",
  "contributors": [
    "Chris Breuer <chris@stacksjs.org>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/chrisbbreuer",
  "homepage": "https://www.lastsoulultra.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/lastsoulultra.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/lastsoulultra/issues"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && bun install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "bun run build:assets && ./buddy build && bun run build:bundles && ./buddy build --docs && bun run audit:docs",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "bun scripts/release-native.ts",
    "release:build": "bun scripts/release-native.ts --bump build",
    "release:patch": "bun scripts/release-native.ts --bump build",
    "release:minor": "bun scripts/release-native.ts --bump minor",
    "release:major": "bun scripts/release-native.ts --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:framework": "bun x --bun tsc --noEmit -p storage/framework/tsconfig.framework.json --pretty false && bun x --bun tsc --noEmit -p storage/framework/tsconfig.defaults.json --pretty false",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:fix": "./buddy types:fix",
    "bench:routing": "bun bench/routing/run.ts",
    "test": "bun test ./tests",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "deps:lockfile:check": "bun .github/scripts/check-lockfile-version.ts",
    "bud": "./buddy",
    "stx": "./buddy",
    "build:assets": "bun scripts/build-site-assets.ts",
    "build:bundles": "bun scripts/externalize-page-bundles.ts",
    "audit:html": "bun scripts/audit-html.ts",
    "audit:docs": "bun run docs:style-guide:check && bun scripts/sync-workout-art.ts --check && bun scripts/sync-style-guide-assets.ts --check && bun scripts/audit-docs.ts",
    "docs:demo": "bun scripts/prepare-demo-docs.ts",
    "native:prepare": "bun scripts/build-native.ts prepare",
    "native:ios": "bun scripts/build-native.ts ios",
    "native:android": "bun scripts/build-native.ts android",
    "native:sign-android": "bun scripts/sign-native-android.ts",
    "native:pin": "bun scripts/pin-platform.ts",
    "native:restore-ios": "bun scripts/restore-native-ios.ts",
    "native:testflight": "bun scripts/release-native-ios.ts",
    "native:verify-ios": "bun scripts/verify-native.ts",
    "native:parity": "bun scripts/verify-hq-parity.ts",
    "docs:style-guide": "./buddy docs:style-guide",
    "docs:style-guide:check": "./buddy docs:style-guide:check"
  },
  "dependencies": {
    "@ts-maps/stx": "0.5.7",
    "stacks": "0.75.538"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "better-dx": "^0.2.38",
    "buddy-bot": "0.10.5"
  },
  "overrides": {
    "@stacksjs/stx": "0.2.842",
    "@stacksjs/components": "0.2.842",
    "bun-plugin-stx": "0.2.842",
    "stx-router": "0.2.842",
    "craft-native": "0.0.492",
    "@craft-native/ios": "0.0.492",
    "@craft-native/android": "0.0.492",
    "bun-query-builder": "0.3.38",
    "@stacksjs/bumpx": "0.2.35",
    "@stacksjs/ts-cloud": "0.16.116"
  }
}
