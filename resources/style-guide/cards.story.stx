<Story title="Race cards, numbers and empty states" group="Data presentation">
  <Variant title="Race summary">
    <section class="space-y-6">
      <p class="kicker">Sample race</p><h2 class="text-4xl font-[family-name:var(--lsu-display)]">ONE MORE YARD</h2>
      <div class="statgrid"><div><p class="stat-v">24</p><p class="stat-l">Yards</p></div><div><p class="stat-v">160.9</p><p class="stat-l">Kilometres</p></div><div><p class="stat-v">1</p><p class="stat-l">Runner remains</p></div></div>
      <article class="card"><p class="kicker-sm">Example result</p><h3 class="card-name">SAMPLE RUNNER</h3><p class="card-body">Steady pacing, one loop at a time. Names and results shown here are fictional.</p></article>
    </section>
  </Variant>
  <Variant title="Empty and error states">
    <section class="space-y-6">
      <div class="space-y-3 coach-empty"><h2 class="font-[family-name:var(--lsu-display)]">NO ENTRIES YET</h2><p>Your confirmed races will appear here.</p><a class="btn" href="#races">Explore races</a></div>
      <div class="space-y-3 coach-empty" role="alert"><h2 class="font-[family-name:var(--lsu-display)]">RESULTS UNAVAILABLE</h2><p>Try again to load the latest race results.</p><button class="btn-outline" type="button">Try again</button></div>
    </section>
  </Variant>
</Story>
