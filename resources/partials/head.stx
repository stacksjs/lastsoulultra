<script server>
import { CARD_HEIGHT, CARD_WIDTH, shareCard } from '../data/share'
import { absolute } from '../data/site'
import { structuredDataJson } from '../data/structured'
const metaPage = typeof currentPage !== 'undefined' && currentPage ? currentPage : { title: 'Last Soul Ultra', description: 'The backyard ultra World Series. There is no finish line.', styles: ['/assets/styles/production/base.css'] }
const pagePath = typeof canonicalPath !== 'undefined' ? canonicalPath : '/'
const card = shareCard(pagePath)
// Not on a noindex page: nothing indexes it, so the graph is bytes a reader
// pays for and no crawler reads.
const graph = metaPage.noindex ? '' : structuredDataJson(pagePath, metaPage.title)
// Origins the page says it will open a connection to, warmed before the
// parser reaches the element that needs them.
const warm = Array.isArray(metaPage.preconnect) ? metaPage.preconnect : []
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ metaPage.title }}</title>
<meta name="description" content="{{ metaPage.description }}">
@if(metaPage.noindex)
<meta name="robots" content="noindex,nofollow">
@endif
<meta name="theme-color" content="#000000">
<link rel="canonical" href="{{ absolute(pagePath) }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Last Soul Ultra">
<meta property="og:title" content="{{ metaPage.title }}">
<meta property="og:description" content="{{ metaPage.description }}">
<meta property="og:url" content="{{ absolute(pagePath) }}">
<meta property="og:image" content="{{ absolute(card.src) }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="{{ CARD_WIDTH }}">
<meta property="og:image:height" content="{{ CARD_HEIGHT }}">
<meta property="og:image:alt" content="{{ card.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ absolute(card.src) }}">
<meta name="twitter:image:alt" content="{{ card.alt }}">
<link rel="icon" href="/assets/lsu/images/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/lsu/images/apple-touch-icon.png">
@foreach(warm as origin)
<link rel="dns-prefetch" href="{{ origin }}">
<link rel="preconnect" href="{{ origin }}" crossorigin>
@endforeach
<link rel="preload" href="/assets/lsu/fonts/anton-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/lsu/fonts/barlow-400-latin.woff2" as="font" type="font/woff2" crossorigin>
@foreach(metaPage.styles as sheet)
<link rel="stylesheet" href="{{ sheet }}">
@endforeach
<link rel="stylesheet" href="/assets/styles/stx-site.css">
@if(graph)
<script type="application/ld+json">{!! graph !!}</script>
@endif
