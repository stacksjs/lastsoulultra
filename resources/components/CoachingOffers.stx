<script>
interface Props {
  /** Heading level for a tier name: 2 under a page heading, 3 under a section. */
  level?: string
}
const { level = '3' } = defineProps<Props>()
</script>
<script server>
import { formatPrice, formatTrial } from '../functions/coaching-brand'
import { loadBrand } from '../functions/coaching-source'

/* The one piece of coaching this site renders itself. The published brand is
   public, so the tiers, the coach behind each one and the coach's own price
   can be read here rather than only inside the frame - a search result, a
   shared link and a visitor with frames blocked all get the same answer.
   Nothing is composed: no price, no trial and no coach name originates here. */
const offerBrand = await loadBrand()
const offers = offerBrand?.offers ?? []
const offerLocale = offerBrand?.locale ?? 'en'
/* A tier name sits directly under the page heading on /coaching/plans and
   under a section heading on the hub, so the level is the caller's to say.
   Getting it wrong is an h1 followed by an h3, which is how a screen-reader
   user loses the outline of the page. */
const offerTop = String(level) === '2'

/* Two different things, and a storefront needs both: what this tier gives you
   (the coach's product description) and how the coach trains people (their
   published method summary). HQ sometimes carries the same sentence in both,
   so the second is dropped when it repeats the first rather than printing a
   paragraph twice. */
const offerRows = offers.map((offer) => {
  const includes = offer.product.description.trim()
  const approach = offer.method.summary.trim()
  return { ...offer, includes, approach: approach && approach !== includes ? approach : '' }
})
</script>
@if(offers.length > 0)
<ul class="coach-offers">
  @foreach(offerRows as offer)
  <li class="coach-offer">
    <div>
      @if(offerTop)
      <h2 class="coach-offer-name">{{ offer.label }}</h2>
      @else
      <h3 class="coach-offer-name">{{ offer.label }}</h3>
      @endif
      <p class="coach-offer-by">{{ offer.coach }}</p>
      @if(offer.includes)
      <p>{{ offer.includes }}</p>
      @endif
      @if(offer.approach)
      <p class="coach-offer-method">{{ offer.approach }}</p>
      @endif
      <p class="coach-offer-note">{{ offer.method.name }}, version {{ offer.method.version }}.</p>
    </div>
    <div class="coach-offer-price">
      <b>{{ formatPrice(offer.product, offerLocale) }}</b>
      @if(formatTrial(offer.product))
      <span class="coach-offer-trial">{{ formatTrial(offer.product) }}</span>
      @endif
    </div>
  </li>
  @endforeach
</ul>
@else
<div class="coach-empty">
  @if(offerTop)
  <h2>Nothing is open yet</h2>
  @else
  <h3>Nothing is open yet</h3>
  @endif
  <p>No coach has published a method here and no price has been set. When the first tier opens it appears here, under the coach's own name and at the coach's own price. This site does not set either.</p>
</div>
@endif
