<script server>
import { formatPrice, formatTrial } from '../functions/coaching-brand'
import { loadBrand, portalHost } from '../functions/coaching-source'

/* The one piece of coaching this site renders itself. The published brand is
   public, so the tiers, the coach behind each one and the coach's own price
   can be read here rather than only inside the frame - a search result, a
   shared link and a visitor with frames blocked all get the same answer.
   Nothing is composed: no price, no trial and no coach name originates here. */
const offerBrand = await loadBrand()
const offers = offerBrand?.offers ?? []
const offerLocale = offerBrand?.locale ?? 'en'
const offerHost = portalHost()
</script>
@if(offers.length > 0)
<ul class="coach-offers">
  @foreach(offers as offer)
  <li class="coach-offer">
    <div>
      <h3>{{ offer.label }}</h3>
      <p class="coach-offer-by">{{ offer.coach }}</p>
      <p>{{ offer.method.summary }}</p>
      <p class="coach-offer-note">{{ offer.method.name }}, version {{ offer.method.version }}. Bought and billed at {{ offerHost }}.</p>
    </div>
    <div class="coach-offer-price">
      <b>{{ formatPrice(offer.product, offerLocale) }}</b>
      @if(formatTrial(offer.product))
      <span class="coach-offer-trial">{{ formatTrial(offer.product) }}</span>
      @endif
    </div>
  </li>
  @endforeach
</ul>
@else
<div class="coach-empty">
  <h2>Nothing is open yet</h2>
  <p>No coach has published a method here and no price has been set. When the first tier opens it appears here, under the coach's own name and at the coach's own price. This site does not set either.</p>
</div>
@endif
