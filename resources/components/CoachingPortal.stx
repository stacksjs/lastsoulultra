<script>
interface Props { section?: string }
const { section = '' } = defineProps<Props>()
</script>
<script server>
import coaching from '../../config/coaching'
import { coachingBrand, coachingOrigin, coachingSection, portalElementUrl, portalUrl } from '../functions/coaching-source'

/* Origin, slug and section are all checked in coaching-source, which is also
   what the module pages build their links from, so the embed and the link
   beside it cannot disagree about where the portal is. */
const portalBrand = coachingBrand()
const portalApi = coachingOrigin()
const portalNamedSection = coachingSection(section)
const portalHref = portalUrl(portalNamedSection)
const portalElement = portalElementUrl()
</script>
<script client>
import { publicCheckoutReceipt } from '../functions/coaching-return'
const coachingSearch = useSearchParams()
const coachingOrder = memo(() => publicCheckoutReceipt(coachingSearch.get('hq_order')))
const coachingSubscription = memo(() => publicCheckoutReceipt(coachingSearch.get('hq_subscription')))
</script>
<script type="module" src="{{ portalElement }}"></script>
<hq-coaching brand="{{ coaching.brand }}" api="{{ portalApi }}" label="Last Soul Ultra coaching" section="{{ portalNamedSection }}" :subscription="coachingSubscription" :order="coachingOrder">
  <p>Training plans, monthly subscriptions and feedback, powered by HQ.</p>
  <a class="btn" href="{{ portalHref }}">Open your training</a>
</hq-coaching>
