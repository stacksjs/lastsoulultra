<script>
interface Props { current?: string }
const { current = '' } = defineProps<Props>()
</script>
<script server>
/** Same rule as the nav: a section marks its own subtree. */
function here(href) {
  if (!current) return false
  if (href === '/') return current === '/'
  return current === href || current.startsWith(`${href}/`)
}
</script>
<script client>
/* Progressive enhancement only. Without this the form still posts: it carries
   format=html and the action answers a readable page. With it the visitor
   stays where they are. A component can run a client script where a full-page
   view cannot, which is why this lives in the footer. */
const lsuMailStatus = state('')
const lsuMailOk = state(false)
const lsuMailBusy = state(false)

async function lsuSubscribe(event) {
  event.preventDefault()
  if (lsuMailBusy()) return

  const form = event.target
  const data = new FormData(form)
  data.delete('format') // the JSON path, not the fallback page

  lsuMailBusy.set(true)
  lsuMailStatus.set('')
  try {
    const response = await fetch(form.action, { method: 'POST', headers: { accept: 'application/json' }, body: data })
    const json = await response.json()
    lsuMailOk.set(json.success === true)
    lsuMailStatus.set(json.message || (json.success ? 'Check your inbox to confirm.' : 'That did not work. Try again.'))
    if (json.success) form.reset()
  }
  catch {
    lsuMailOk.set(false)
    lsuMailStatus.set('That did not reach us. Check your connection and try again.')
  }
  finally {
    lsuMailBusy.set(false)
  }
}
</script>
