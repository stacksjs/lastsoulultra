<div class="footer-signup lsu-sz7xmlte">
<form class="lsu-sz7xmlte signup" action="/api/email/subscribe" method="post" @submit="lsuSubscribe(event)">
<input type="hidden" name="format" value="html" class="lsu-sz7xmlte">
<input type="hidden" name="source" value="footer" class="lsu-sz7xmlte">
<div class="lsu-sz7xmlte signup-copy">
<label class="lsu-sz7xmlte signup-label" for="footer-email">Two emails a year</label>
<p class="lsu-sz7xmlte signup-note">One when entries open, one when the race starts. We send a confirmation link first and use the address for nothing until you click it. <a href="/privacy" class="lsu-sz7xmlte">Privacy</a>.</p>
</div>
