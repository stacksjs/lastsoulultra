<input id="footer-email" class="lsu-sz7xmlte" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
<button class="btn lsu-sz7xmlte" type="submit" :disabled="lsuMailBusy()" :text="lsuMailBusy() ? 'Sending' : 'Sign up'">Sign up</button>
</div>
<p :if="lsuMailStatus()" class="lsu-sz7xmlte signup-status" :class="lsuMailOk() ? 'is-ok' : 'is-bad'" role="status" aria-live="polite" :text="lsuMailStatus()"></p>
</form>
