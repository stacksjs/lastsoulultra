<script>
interface Props { slug: string }
const { slug } = defineProps<Props>()
</script>
<script server>
import { coachingModule } from '../data/coaching'
import { loadBrand, portalUrl } from '../functions/coaching-source'
const panel = coachingModule(slug)
if (!panel) throw new Error(`unknown coaching module: ${slug}`)
const panelBrand = await loadBrand()
const panelLive = Boolean(panelBrand?.modules.includes(panel.slug))
const panelHref = portalUrl(panel.slug)
</script>
<div class="coaching-surface training-surface">
  <TrainingNav current="{{ panel.slug }}" />
  <div class="training-content">
    <header class="training-title"><h1>{{ panel.title }}</h1></header>
    @if(panelLive)
    @if(panel.slug === 'plans')
    <noscript><CoachingOffers level="2" /></noscript>
    @endif
    <div class="coach-panel"><CoachingPortal section="{{ panel.slug }}" /></div>
    <details class="training-about">
      <summary>About your training workspace</summary>
      @if(panel.scope === 'private')
      <strong>Only you see this</strong><p>Your health and messages belong to your training account. An organization role does not grant access to every athlete's private records.</p>
      @elseif(panel.scope === 'athlete')
      <strong>Your training account</strong><p>Sign in inside the panel with the account that holds your subscription. Race entry uses a separate account.</p>
      @endif
      <p>{{ panel.summary }}</p>
      <a href="{{ panelHref }}" target="_blank" rel="noopener">Open your training in a new tab</a>
    </details>
    @else
    <div class="coach-empty"><h2>{{ panel.slug === 'plans' ? 'Nothing is open yet' : 'Not open yet' }}</h2><p>No coach has published a method here. This workspace fills in once a tier opens.</p><a href="/coaching">Back to coaching</a></div>
    @endif
  </div>
</div>
