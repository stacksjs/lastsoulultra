<script server>
import { moduleHref } from '../data/coaching'
import { coachingOrigin } from '../functions/coaching-source'
/* Training is signed in to where the training account lives, not here. */
const rpTraining = moduleHref('calendar', coachingOrigin())
</script>
<script client>
import { raceAccount, formValues } from '../functions/race-api'
import { SIZES, entryDeadline, entryFee, entryTasks, openCheckout, placeToConfirm, profileReturnUrl, wait } from '../functions/entry-confirm'
import { closeDialog, dialogAround, onEntryLinks, showDialog } from '../functions/entry-dialog'
const rp = raceAccount()
const rpRoot = useRef('rpRoot')
/* In the race-entry window (RaceEntryDialog) the portal is one race's
   request, opened from a link, rather than the account page it is on
   /lottery and /profile. */
const rpInDialog = state(false)
let rpLoaded = false
let rpStopLinks = () => {}
const rpUser = rp.user
const rpApplications = rp.applications
const rpEvents = rp.events
const rpSigned = rp.signedIn
const rpBusy = rp.busy
const rpError = rp.error
const rpMessage = rp.message
const rpMode = rp.mode
const rpFirst = state('')
const rpLast = state('')
const rpEmail = state('')
const rpPassword = state('')
const rpCode = state('')
const rpEventSlug = state('')
const rpEvent = derived(() => rpEvents().find(item => item.slug === rpEventSlug()) || null)
const rpEntry = derived(() => rpApplications().find(item => item.event.slug === rpEventSlug()) || null)
const rpStage = state(1)
/* Past editing: submitted in this window, or a request the team has moved on
   (in selection, selected, not selected). An entered request stays editable
   while its event is open, as on the published site. */
const rpDone = derived(() => rpStage() >= 4 || !['', 'not_entered', 'entered', 'draft', 'withdrawn'].includes(String(rpEntry()?.application?.display_status || rpEntry()?.application?.status || '')))
/* The window's three stages: sign in, request, complete. */
const rpOuterStage = derived(() => !rpSigned() ? 1 : rpDone() ? 3 : 2)
const rpReason = state('')
const rpNoPb = state(true)
const rpPbYards = state('')
const rpPbEvent = state('')
const rpPbDate = state('')
const rpPbProof = state('')
const rpSocial = state('')
const rpAccurate = state(false)
const rpRules = state(false)
const rpSaved = state('')
const rpWriting = sharedRequest()
const rpRequestPath = () => '/events/' + encodeURIComponent(rpEventSlug()) + '/application'
function rpAuth() { return rp.authenticate({ first_name: rpFirst(), last_name: rpLast(), email: rpEmail(), password: rpPassword(), code: rpCode() }) }
function rpChoose() {
  rpStage.set(1)
  const application = rpEntry()?.application
  rpReason.set(application?.reason || '')
  rpNoPb.set(application?.no_backyard_pb !== false)
  rpPbYards.set(String(application?.pb_yards || ''))
  rpPbEvent.set(application?.pb_event || '')
  rpPbDate.set(application?.pb_date || '')
  rpPbProof.set(application?.pb_proof_url || '')
  rpSocial.set(application?.social?.other || '')
}
async function rpSaveProfile(event) {
  rpBusy.set(true)
  rpError.set('')
  try {
    const values = formValues(event)
    const body = Object.fromEntries(Object.entries(values).map(([key, value]) => [key, String(value).trim() || null]))
    rpUser.set(await rp.request('/me', 'PATCH', body))
    rpStage.set(2)
  }
  catch (error) { rpError.set(error.message || 'Could not save your details') }
  finally { rpBusy.set(false) }
}
function rpDraft() {
  return { reason: rpReason(), no_backyard_pb: rpNoPb(), pb_yards: rpNoPb() ? null : Number(rpPbYards()), pb_event: rpNoPb() ? null : rpPbEvent(), pb_date: rpNoPb() ? null : rpPbDate() || null, pb_proof_url: rpNoPb() ? null : rpPbProof() || null, social: { other: rpSocial() } }
}
async function rpSaveDraft(advance = false) {
  if (!rpEvent() || rpEvent().phase !== 'open' || !rpSigned()) return
  rpError.set('')
  try {
    const slug = rpEventSlug()
    const snapshot = rpDraft()
    const path = rpRequestPath()
    await rpWriting.fresh(slug, () => rp.request(path, 'PUT', rpEventSlug() === slug ? rpDraft() : snapshot))
    rpSaved.set('Draft saved')
    if (advance) rpStage.set(3)
  }
  catch (error) { rpError.set(error.message || 'Your draft could not be saved') }
}
const rpAutosave = useTimeout(() => rpSaveDraft(), 900)
rpAutosave.stop()
watch(() => JSON.stringify(rpDraft()), () => { if (rpStage() === 2) { rpSaved.set('Saving…'); rpAutosave.start() } })
async function rpSubmit() {
  if (!rpAccurate() || !rpRules() || rpBusy()) return
  rpBusy.set(true)
  rpError.set('')
  try {
    rpAutosave.stop()
    await rpWriting.fresh(rpEventSlug(), () => rp.request(rpRequestPath(), 'PUT', { ...rpDraft(), accuracy_attested: rpAccurate(), rules_accepted: rpRules() }))
    await rp.request(rpRequestPath() + '/submit', 'POST', {})
    await rp.load()
    rpStage.set(4)
    rpMessage.set('Your race entry request has been submitted.')
  }
  catch (error) { rpError.set(error.message || 'Your request could not be submitted') }
  finally { rpBusy.set(false) }
}
async function rpWithdraw(slug) {
  rpBusy.set(true)
  try {
    await rp.request('/events/' + encodeURIComponent(slug) + '/application/withdraw', 'POST', {})
    await rp.load()
    rpMessage.set('Your application has been withdrawn.')
  }
  catch (error) { rpError.set(error.message || 'Could not withdraw') }
  finally { rpBusy.set(false) }
}
/* Confirming a selected place: the agreement, the race details and the fee. */
const rpPlace = derived(() => placeToConfirm(rpApplications()))
const rpTasks = derived(() => entryTasks(rpPlace()?.entry))
const rpPlaceConfirmed = derived(() => rpPlace()?.entry?.status === 'confirmed')
const rpPayStatus = derived(() => rpPlace()?.entry?.payment?.status || 'unpaid')
const rpFee = derived(() => entryFee(rpPlace()?.entry?.payment))
const rpWaiver = state(null)
const rpWaiverState = state('idle')
const rpSigner = state('')
const rpAccept = state(false)
const rpMedical = state(false)
const rpEditDetails = state(false)
const rpConfirmNote = state('')
const rpConfirmBad = state(false)
function rpNote(text, bad = false) { rpConfirmNote.set(text); rpConfirmBad.set(bad) }
async function rpLoadWaiver() {
  const entry = rpPlace()?.entry
  if (!entry || rpTasks().signed || rpPlaceConfirmed()) return
  rpWaiverState.set('loading')
  try {
    rpWaiver.set(await rp.request('/entries/' + encodeURIComponent(entry.id) + '/waiver'))
    rpWaiverState.set('ready')
  }
  catch (error) { rpWaiverState.set(error.status === 404 ? 'missing' : 'failed') }
}
async function rpRefresh(done) {
  const before = rpPlace()?.entry?.status
  await rp.load()
  if (done) rpNote(before === 'selected' && rpPlace()?.entry?.status === 'confirmed' ? done + ' That was the last one: your place is confirmed.' : done)
}
async function rpSign() {
  const entry = rpPlace()?.entry
  if (!entry || !rpWaiver() || rpBusy()) return
  rpBusy.set(true)
  try {
    await rp.request('/entries/' + encodeURIComponent(entry.id) + '/waiver/sign', 'POST', { waiver_version_id: rpWaiver().id, signer_name: rpSigner().trim(), accepted: rpAccept(), medical_attested: rpMedical() })
    await rpRefresh('Agreement signed.')
  }
  catch (error) { rpNote(error.message || 'The agreement could not be signed', true) }
  finally { rpBusy.set(false) }
}
async function rpSaveDetails(event) {
  const entry = rpPlace()?.entry
  if (!entry || rpBusy()) return
  rpBusy.set(true)
  try {
    const values = formValues(event)
    const body = Object.fromEntries(Object.entries(values).map(([key, value]) => [key, String(value).trim() || null]))
    await rp.request('/entries/' + encodeURIComponent(entry.id) + '/logistics', 'PUT', body)
    rpEditDetails.set(false)
    await rpRefresh('Your details are saved.')
  }
  catch (error) { rpNote(error.message || 'Your details could not be saved', true) }
  finally { rpBusy.set(false) }
}
async function rpPay() {
  const entry = rpPlace()?.entry
  if (!entry || rpBusy()) return
  rpBusy.set(true)
  try {
    const checkout = await rp.request('/entries/' + encodeURIComponent(entry.id) + '/payment/checkout', 'POST', { return_url: profileReturnUrl() })
    if (!openCheckout(checkout?.url)) throw new Error('The payment page could not be opened. Please try again.')
  }
  catch (error) { rpNote(error.message || 'The payment page could not be opened', true); rpBusy.set(false) }
}
async function rpAfterPayment(result) {
  if (result === 'cancelled') { rpNote('Payment cancelled. Nothing was charged; you can pay whenever you are ready.', true); return }
  if (result !== 'success' || !rpPlace()) return
  if (rpPayStatus() === 'paid') { rpNote('Payment received. Thank you.'); return }
  rpNote('Thank you. Confirming your payment…')
  for (let attempt = 0; attempt < 10; attempt++) {
    await wait(2000)
    await rp.load()
    if (rpPayStatus() === 'paid') { rpNote('Payment received.'); return }
  }
  rpNote('Your payment is still being confirmed. We will email you when it lands.')
}
watch(() => rpPlace()?.entry?.id, () => {
  rpSigner.set([rpUser()?.first_name, rpUser()?.last_name].filter(Boolean).join(' '))
  rpLoadWaiver()
})

/* Open the window for the race a link names, or the open one. The account is
   fetched on the first open, not on every page that carries the window. */
async function rpOpen(query) {
  const auth = query.get('auth')
  if (['create', 'login', 'forgot', 'verify', 'reset'].includes(auth)) rpMode.set(auth === 'create' ? 'register' : auth)
  rpMessage.set('')
  showDialog(dialogAround(rpRoot.current))
  if (!rpLoaded) { rpLoaded = true; await rp.load() }
  const wanted = String(query.get('event') || '')
  rpEventSlug.set(rpEvents().some(item => item.slug === wanted) ? wanted : rpEvents().find(item => item.phase === 'open')?.slug || '')
  rpChoose()
}
function rpClose() { closeDialog(dialogAround(rpRoot.current)) }

onMount(async () => {
  if (dialogAround(rpRoot.current)) {
    rpInDialog.set(true)
    rpStopLinks = onEntryLinks(query => { rpOpen(query) })
    return
  }
  await rp.load()
  const query = useRoute().query || {}
  if (query.payment) rpAfterPayment(String(query.payment))
  if (['create', 'login', 'forgot', 'verify', 'reset'].includes(query.auth)) rpMode.set(query.auth === 'create' ? 'register' : query.auth)
  rpEventSlug.set(String(query.event || rpEvents().find(item => item.phase === 'open')?.slug || ''))
  rpChoose()
})
onDestroy(() => { rpAutosave.stop(); rpStopLinks() })
</script>
<div class="race-portal" x-ref="rpRoot">
  <div :if="rpInDialog" class="entry-dialog-bar">
    <ol class="entry-dialog-stages" aria-label="Steps to request an entry">
      <li :class="rpOuterStage > 1 ? 'done' : ''" :aria-current="rpOuterStage === 1 ? 'step' : undefined"><span class="entry-dialog-n">Stage 1</span><span class="entry-dialog-label">Sign in</span></li>
      <li :class="rpOuterStage > 2 ? 'done' : ''" :aria-current="rpOuterStage === 2 ? 'step' : undefined"><span class="entry-dialog-n">Stage 2</span><span class="entry-dialog-label">Request</span></li>
      <li :aria-current="rpOuterStage === 3 ? 'step' : undefined"><span class="entry-dialog-n">Stage 3</span><span class="entry-dialog-label">Complete</span></li>
    </ol>
    <button type="button" class="entry-dialog-close" aria-label="Close" @click="rpClose()"><span aria-hidden="true">×</span></button>
  </div>
  <p :if="rpInDialog && rpEvent" class="entry-dialog-race" :text="(rpEvent.country_name || rpEvent.name) + (rpEvent.season ? ' · Season ' + rpEvent.season : '')"></p>
  <p :if="rpError" :text="rpError" role="alert"></p><p :if="rpMessage" :text="rpMessage" role="status"></p>
  <template :if="!rpSigned">
    <h2 :text="rpMode === 'register' ? 'Create account' : rpMode === 'login' ? (rpInDialog ? 'Sign in to request an entry' : 'Sign in') : rpMode === 'forgot' ? 'Reset your password' : 'Check your email'"></h2>
    <p :if="!rpInDialog">Use your race-entry account. For your training subscription, <a href="{{ rpTraining }}">sign in to Training</a>.</p>
    <div :if="!rpInDialog" class="race-tabs"><button type="button" @click="rpMode.set('login')" :aria-selected="rpMode === 'login'">Sign in</button><button type="button" @click="rpMode.set('register')" :aria-selected="rpMode === 'register'">Create account</button><button type="button" @click="rpMode.set('forgot')">Forgot password?</button></div>
    <form @submit.prevent="rpAuth()">
      <div :if="rpMode === 'register'" class="field-row"><label>First name<input x-model="rpFirst" autocomplete="given-name" required></label><label>Last name<input x-model="rpLast" autocomplete="family-name" required></label></div>
      <label>Email<input type="email" x-model="rpEmail" autocomplete="email" required></label>
      <label :if="rpMode === 'verify' || rpMode === 'reset'">Verification code<input x-model="rpCode" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" required></label>
      <label :if="rpMode === 'login' || rpMode === 'register' || rpMode === 'reset'">Password<input type="password" x-model="rpPassword" minlength="8" :autocomplete="rpMode === 'login' ? 'current-password' : 'new-password'" required></label>
      <p :if="rpMode === 'register'">By creating an account you agree to the <a href="/terms">terms</a>. Read our <a href="/privacy">privacy policy</a>.</p>
      <button type="submit" class="btn" :disabled="rpBusy" :text="rpBusy ? 'Please wait…' : rpMode === 'register' ? 'Create account' : rpMode === 'forgot' ? 'Send reset code' : rpMode === 'login' ? 'Sign in' : 'Continue'"></button>
    </form>
    <p :if="rpInDialog" class="entry-dialog-links">
      <button :if="rpMode !== 'login'" type="button" @click="rpMode.set('login')">Sign in</button>
      <button :if="rpMode !== 'register'" type="button" @click="rpMode.set('register')">Create account</button>
      <button :if="rpMode === 'login'" type="button" @click="rpMode.set('forgot')">Forgot password?</button>
    </p>
  </template>
  <template :if="rpSigned && rpUser">
    <h2 :text="'Hello, ' + rpUser.first_name"></h2><button type="button" class="btn btn-outline" @click="rp.logout()">Sign out</button>
    <section :if="rpPlace && !rpInDialog" class="confirm-place" :class="rpPlaceConfirmed ? 'is-confirmed' : ''" aria-labelledby="confirm-title">
      <div class="confirm-head"><h3 id="confirm-title" :text="(rpPlaceConfirmed ? 'Your place is confirmed' : 'Confirm your place') + ': ' + rpPlace.event.name"></h3><p class="confirm-count" :text="rpTasks.done + ' of 3 done'"></p></div>
      <div class="confirm-bar" role="progressbar" aria-label="Tasks done" aria-valuemin="0" aria-valuemax="3" :aria-valuenow="rpTasks.done"><span :class="rpTasks.done > 0 ? 'on' : ''"></span><span :class="rpTasks.done > 1 ? 'on' : ''"></span><span :class="rpTasks.done > 2 ? 'on' : ''"></span></div>
      <p class="confirm-lead" :text="rpPlaceConfirmed ? 'Agreement signed, details saved, fee settled. See you on the start line.' : (rpPlace.entry.deadline_at ? 'Three things to do by ' + entryDeadline(rpPlace.entry.deadline_at) : 'Three things to do') + ', in any order. Your place confirms itself the moment the last one is done.'"></p>
      <p :if="rpConfirmNote" class="form-message" :class="rpConfirmBad ? 'error' : 'success'" :text="rpConfirmNote" role="status"></p>
      <ol class="tasks">
        <li class="task" :class="rpTasks.signed ? 'is-done' : 'is-todo'"><details :open="!rpTasks.signed"><summary><span class="task-title">1. Participant agreement</span><span class="task-state" :text="rpTasks.signed ? 'Signed' : rpWaiverState === 'missing' ? 'Not published yet' : 'To do'"></span></summary>
          <p :if="rpTasks.signed" class="step-done">Signed, with your medical self-attestation.</p>
          <p :if="!rpTasks.signed && rpWaiverState === 'missing'" class="step-done">The agreement for this race is not published yet. We will email you when it is. Your details and the fee can be done now.</p>
          <p :if="!rpTasks.signed && rpWaiverState === 'failed'" class="step-done">The agreement could not be loaded. Reload the page to try again.</p>
          <form :if="!rpTasks.signed && rpWaiverState !== 'missing' && rpWaiverState !== 'failed'" class="confirm-form" @submit.prevent="rpSign()">
            <div class="waiver-text" tabindex="0" :text="rpWaiver ? (rpWaiver.title || 'Participant agreement') + '\n\n' + (rpWaiver.body_markdown || '') : 'Loading the agreement…'"></div>
            <label>Full name, as your signature<input x-model="rpSigner" autocomplete="name" minlength="2" maxlength="200" required></label>
            <label class="check"><input type="checkbox" x-model="rpAccept" required>I have read the participant agreement and I accept it.</label>
            <label class="check"><input type="checkbox" x-model="rpMedical" required>Medical self-attestation: I am fit to take part in a race of this kind and know of no condition that makes it unsafe for me.</label>
            <button type="submit" class="btn" :disabled="rpBusy || !rpWaiver || !rpAccept || !rpMedical">Sign the agreement</button>
          </form>
        </details></li>
        <li class="task" :class="rpTasks.details ? 'is-done' : 'is-todo'"><details :open="rpTasks.signed && !rpTasks.details"><summary><span class="task-title">2. Your race details</span><span class="task-state" :text="rpTasks.details ? 'Saved' : 'To do'"></span></summary>
          <p :if="rpTasks.details && !rpEditDetails" class="step-done">Address, sizes and emergency contact saved. <button type="button" class="step-link" @click="rpEditDetails.set(true)">Change them</button></p>
          <form :if="!rpTasks.details || rpEditDetails" class="confirm-form" @submit.prevent="rpSaveDetails($event)">
            <label>Address<input name="address_line1" maxlength="200" autocomplete="address-line1" :value="rpPlace.entry.logistics?.address_line1 || ''" required></label>
            <label>Address line 2 (optional)<input name="address_line2" maxlength="200" autocomplete="address-line2" :value="rpPlace.entry.logistics?.address_line2 || ''"></label>
            <div class="field-row"><label>Town or city<input name="city" maxlength="200" autocomplete="address-level2" :value="rpPlace.entry.logistics?.city || ''" required></label><label>Postcode<input name="postcode" maxlength="200" autocomplete="postal-code" :value="rpPlace.entry.logistics?.postcode || ''" required></label></div>
            <div class="field-row"><label>Country, three-letter code<input name="country" minlength="3" maxlength="3" placeholder="DEU" :value="rpPlace.entry.logistics?.country || ''" required></label><label>Phone<input name="phone" type="tel" maxlength="200" autocomplete="tel" :value="rpPlace.entry.logistics?.phone || ''" required></label></div>
            <div class="field-row"><label>Top size<select name="top_size" :value="rpPlace.entry.logistics?.top_size || ''" required><option value="">Choose…</option><option :for="size in SIZES" :value="size" :text="size"></option></select></label><label>Bottom size<select name="bottom_size" :value="rpPlace.entry.logistics?.bottom_size || ''" required><option value="">Choose…</option><option :for="size in SIZES" :value="size" :text="size"></option></select></label></div>
            <p class="form-sub">Emergency contact</p>
            <div class="field-row"><label>Name<input name="emergency_name" maxlength="200" :value="rpPlace.entry.logistics?.emergency_name || ''" required></label><label>Phone<input name="emergency_phone" type="tel" maxlength="200" :value="rpPlace.entry.logistics?.emergency_phone || ''" required></label></div>
            <label>Relationship<input name="emergency_relationship" maxlength="200" placeholder="Partner, parent, friend…" :value="rpPlace.entry.logistics?.emergency_relationship || ''" required></label>
            <button type="submit" class="btn" :disabled="rpBusy">Save my details</button>
          </form>
        </details></li>
        <li class="task" :class="rpTasks.paid ? 'is-done' : 'is-todo'"><details :open="rpTasks.signed && rpTasks.details && !rpTasks.paid"><summary><span class="task-title">3. Entry fee</span><span class="task-state" :text="rpPayStatus === 'paid' ? 'Settled' : rpPayStatus === 'pending' ? 'Being confirmed' : rpPayStatus === 'failed' ? 'Did not go through' : rpFee + ' to pay'"></span></summary>
          <p :if="rpPayStatus === 'paid'" class="step-done">Settled. Nothing more to pay.</p>
          <p :if="rpPayStatus === 'pending'" class="step-done">Your payment is being confirmed. This page updates when it lands.</p>
          <template :if="rpPayStatus !== 'paid' && rpPayStatus !== 'pending'">
            <p :if="rpPayStatus === 'failed'" class="error form-message">The last payment did not go through. You can try again.</p>
            <button type="button" class="btn" :disabled="rpBusy" @click="rpPay()" :text="'Pay ' + rpFee"></button>
            <p class="step-note">You will pay on a secure card page and come back here.</p>
          </template>
        </details></li>
      </ol>
    </section>
    <section :if="!rpInDialog"><h3>Your entries</h3><p :if="!rpApplications.length">You have not requested a race entry yet.</p><article :for="item in rpApplications"><h4 :text="item.event.name"></h4><p :text="item.application.display_status || item.application.status"></p><p :if="item.entry?.deadline_at" :text="'Confirm by ' + entryDeadline(item.entry.deadline_at)"></p><details :if="item.event.phase === 'open' && item.application.status !== 'withdrawn'"><summary>Withdraw this application</summary><p>This removes your application from this event.</p><button type="button" class="btn btn-outline" :disabled="rpBusy" @click="rpWithdraw(item.event.slug)">Withdraw my application</button></details></article></section>
    <label :if="!rpInDialog">Event<select x-model="rpEventSlug" @change="rpChoose()"><option value="">Choose a race</option><option :for="event in rpEvents" :value="event.slug" :text="event.name"></option></select></label>
    <p :if="rpEvent && rpEvent.phase !== 'open'">This event is not accepting direct entry requests. <a href="/world-series#qualify">View the entry and qualification rules.</a></p>
    <p :if="rpInDialog && !rpEvent">No race is taking entry requests right now. <a href="/world-series">See the World Series dates.</a></p>
    <div :if="rpInDialog && rpDone" class="entry-dialog-done">
      <p class="entry-dialog-status" :text="rpStage >= 4 ? 'Request sent' : (rpEntry?.application?.display_status || rpEntry?.application?.status || '').replace(/_/g, ' ')"></p>
      <p>Places are selected by the LSU team. If you are selected, we email you with the next steps.</p>
      <a class="btn" href="/profile">View your entry</a>
    </div>
    <template :if="rpEvent && rpEvent.phase === 'open' && !(rpInDialog && rpDone)">
      <p :text="(rpInDialog ? 'Step ' : 'Stage ') + Math.min(rpStage, 3) + ' of 3'"></p>
      <form :if="rpStage === 1" @submit.prevent="rpSaveProfile($event)">
        <h3>Personal details</h3><div class="field-row"><label>First name<input name="first_name" :value="rpUser.first_name" autocomplete="given-name" required></label><label>Last name<input name="last_name" :value="rpUser.last_name" autocomplete="family-name" required></label></div>
        <label>Date of birth<input name="date_of_birth" type="date" :value="rpUser.date_of_birth" required></label><label>Gender<select name="gender" :value="rpUser.gender" required><option value="female">Female</option><option value="male">Male</option><option value="non_binary">Non-binary</option></select></label><label>Country of residence, three-letter code<input name="country_of_residence" :value="rpUser.country_of_residence" minlength="3" maxlength="3" placeholder="DEU" required></label><label>Nationality, three-letter code<input name="nationality" :value="rpUser.nationality" minlength="3" maxlength="3" placeholder="DEU" required></label><label>Town or city<input name="town" :value="rpUser.town"></label><label>Instagram<input name="instagram" :value="rpUser.instagram"></label><label>Strava<input name="strava" :value="rpUser.strava"></label>
        <button type="submit" class="btn" :disabled="rpBusy">Save and continue</button>
      </form>
      <form :if="rpStage === 2" @submit.prevent="rpSaveDraft(true)"><h3>Your request</h3><label>Why do you want to take part?<textarea x-model="rpReason" rows="5" required maxlength="4000"></textarea></label><label><input type="checkbox" x-model="rpNoPb">I have not run a backyard ultra before</label><div :if="!rpNoPb"><label>Personal best, yards<input type="number" min="1" x-model="rpPbYards" required></label><label>Event<input x-model="rpPbEvent" required></label><label>Date<input type="date" x-model="rpPbDate"></label><label>Proof link<input type="url" x-model="rpPbProof"></label></div><label>Other social links<input x-model="rpSocial"></label><p :text="rpSaved" role="status"></p><button type="button" class="btn btn-outline" @click="rpStage.set(1)">Back</button><button type="submit" class="btn" :disabled="rpBusy">Review request</button></form>
      <form :if="rpStage === 3" @submit.prevent="rpSubmit()"><h3>Review your request</h3><p :text="rpReason"></p><label><input type="checkbox" x-model="rpAccurate" required>I confirm that the information I provided is accurate.</label><label><input type="checkbox" x-model="rpRules" required>I accept the <a href="/format">race rules</a> and <a href="/terms">terms</a>.</label><button type="button" class="btn btn-outline" @click="rpStage.set(2)">Back</button><button type="submit" class="btn" :disabled="rpBusy || !rpAccurate || !rpRules">Submit race entry request</button></form>
    </template>
    <p :if="!rpInDialog">Looking for your training subscription? <a href="/coaching#training">Open LSU coaching.</a></p>
  </template>
</div>
