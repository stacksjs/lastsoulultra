@extends('layouts/LSU')
@section('content')
<script server>
import { appStoreListed, appStoreUrl, appTiers } from '~/resources/data/app-stores'
import { moduleHref } from '~/resources/data/coaching'
import { coachingOrigin } from '~/resources/functions/coaching-source'
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/app"]
const canonicalPath = "/app"
const appListed = appStoreListed()
const appOnWeb = moduleHref('calendar', coachingOrigin())
</script>
<div class="app-page">

<section class="app-hero">
  <div class="app-hero-copy">
    <span class="kicker">The Last Soul Ultra app</span>
    <h1>Train for<br><span class="accent">the next start.</span></h1>
    <p>Running and strength from a coach's method, two weeks at a time. How your sessions went shapes the next block, and an LSU coach approves every one.</p>
    <div class="app-actions">
      @if(appListed)
      <a class="btn btn-lg" href="{{ appStoreUrl }}">Download on the App Store</a>
      <a class="btn-outline" href="{{ appOnWeb }}">Open it on the web</a>
