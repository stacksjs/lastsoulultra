@extends('layouts/LSU')
@section('content')
<script server>
import { coachShare } from '~/resources/data/app-stores'
import { coachingHubStyles, moduleHref } from '~/resources/data/coaching'
import { coachingOrigin, loadBrand } from '~/resources/functions/coaching-source'

// The home, race-entry and next-loop sheets are each suffixed with their own
// page scope, so none of their rules could ever match here. This page's own
// rules are coaching-page.css, loaded by this route alone; the storefront and
// module index it carries are styled by the surface sheet, which the eight
// module routes load too.
/* The embed, and the connection warmed for it, only when the brand has
   published something. The branded subscription return lands on this page
   with its receipt hint and the element is what passes that back to HQ - but
   an unpublished brand has no subscriptions, so there is no receipt to carry
   and no reason to load a remote script to frame a 404. */
const hubBrand = await loadBrand()
const hubLive = (hubBrand?.modules.length ?? 0) > 0
const currentPage = { title: 'Coaching - Last Soul Ultra', description: 'Training from a coach\'s method, two weeks at a time. How your sessions went shapes the next block, and an LSU coach approves every one.', styles: coachingHubStyles, ...(hubLive ? { preconnect: [coachingOrigin()] } : {}) }
const canonicalPath = '/coaching'
const hubTraining = moduleHref('calendar', coachingOrigin())
</script>
<script client>
import { publicCheckoutReceipt } from '../functions/coaching-return'
/* The training app sends a runner back to this page after checkout, with a
   receipt in the address. Only then is its panel drawn here, to confirm the
   purchase. Without a receipt the panel would be the storefront a second time,
   a page inside the page repeating the tiers printed just above it. */
const hubSearch = useSearchParams()
const hubReturn = memo(() => Boolean(publicCheckoutReceipt(hubSearch.get('hq_order')) || publicCheckoutReceipt(hubSearch.get('hq_subscription'))))
</script>
<div class="coaching-page">

<section class="coaching-hero">
  <div class="coaching-hero-copy">
    <span class="kicker">Last Soul Ultra / Coaching</span>
    <h1>Say how it went.<br><span class="accent">The next block follows.</span></h1>
    <p>Log each session and say how it felt. Your next two weeks are drafted from it, inside a coach's method, and an LSU coach approves them.</p>
    @if(hubLive)
    <a class="btn btn-lg" href="#training">Open the portal</a>
    @else
    <a class="btn btn-lg" href="#training">See what is coming</a>
    @endif
  </div>
  <div class="coaching-hero-shot">
    <img src="/assets/lsu/images/recap-06-810.webp" srcset="/assets/lsu/images/recap-06-540.webp 540w, /assets/lsu/images/recap-06-810.webp 810w, /assets/lsu/images/recap-06-1080.webp 1080w" sizes="(min-width: 900px) 42vw, 100vw" alt="A runner in a white sun hat and neck cover looks down at his watch." width="1080" height="1440" loading="eager" fetchpriority="high" decoding="async">
  </div>
</section>

<div class="coaching-body">
  <section id="how">
    <div class="coaching-head">
      <h2 class="h2-sm">A plan that listens.<br><span class="accent">Not one you print.</span></h2>
      <p>A finished twelve-week plan is done the day you buy it. This one is written two weeks at a time, from how the last two went.</p>
    </div>
    <div class="coaching-loop">
      <article>
        <h3>Train</h3>
        <p>You get two weeks of sessions from a coach's method. Not a generic block for everyone.</p>
      </article>
      <article>
        <h3>Log</h3>
        <p>Mark it done or skipped, rate the effort and how it felt, and leave a note. Legs heavy, work got busy, that hill broke you.</p>
      </article>
      <article>
        <h3>Adapt</h3>
        <p>Your next two weeks are drafted from how the last two went, inside the method's rules. An LSU coach reads the draft, changes what they want and approves it.</p>
      </article>
    </div>
  </section>

  <aside class="coaching-note">
    <h2>You train.<br><span class="accent">A coach signs off.</span></h2>
    <p>Every block is approved by an LSU coach before it reaches you. An AI coach answers questions about your data, and cannot change your training. There is no one-to-one coaching here.</p>
    <p>That gets most runners most of the way. For the last stretch, you go straight to a coach and work with them one to one.</p>
  </aside>
</div>

<section class="band coaching-band">
  <div class="band-bg" style="background-image:url('/assets/lsu/images/rappid-65.webp');background-position:center 40%"></div>
  <div class="band-scrim"></div>
  <div class="band-copy">
    <p>Every race so far<br><span class="accent">has run at a loss.</span></p>
    <p class="coaching-band-note">A brand got built and no money came in. Other races fix that with dearer tickets and unpaid volunteers. This is the other way.</p>
  </div>
</section>

<div class="coaching-body">
  <section id="method">
    <div class="coaching-head">
      <h2 class="h2-sm">Not a plan.<br><span class="accent">A way of training.</span></h2>
      <p>A method is one coach's whole approach, named after them. Your weeks come out of it. Each coach who joins brings their own.</p>
    </div>
    <div class="coaching-steps">
      <article>
        <h3>Running</h3>
        <p>The base. Easy miles, the long one, the hard session, and the taper into a start.</p>
      </article>
      <article>
        <h3>Strength</h3>
        <p>Lifting and the small work that keeps a beginner's knees and hips in one piece over a long block.</p>
      </article>
      <article>
        <h3>Mind</h3>
        <p>Breathing, meditation and the bit nobody trains: what you do at 3 a.m. when you want to stop.</p>
      </article>
    </div>
    <p class="coaching-tiers">A tier can include running, strength or a combination of disciplines. The portal shows which tiers are open and what they cost.</p>
  </section>

  <section id="training">
    <div class="coaching-head">
      @if(hubLive)
      <h2 class="h2-sm">What is open.<br><span class="accent">And where it runs.</span></h2>
      <p>The tiers a coach has published, then the eight panels your training lives in once you are in one.</p>
      @else
      <h2 class="h2-sm">Not open yet.<br><span class="accent">It opens here.</span></h2>
      <p>When a coach publishes a method, its tiers appear on this page, and the panels your training runs in open below them.</p>
      @endif
    </div>
    <div class="coaching-surface">
      <CoachingOffers />
      @if(hubLive)
      <div class="coaching-doors">
        <a class="btn" href="/coaching/plans">Choose a tier</a>
        <a class="btn-outline" href="{{ hubTraining }}">Open your training</a>
      </div>
      @endif
      <CoachingIndex />
    </div>
    @if(hubLive)
    <div class="coaching-portal" :if="hubReturn()"><CoachingPortal /></div>
    @endif
  </section>

  <section id="coaches" class="coaching-coaches">
    <div>
      <span class="kicker">For coaches</span>
      <h2 class="h2-sm">Bring your method.<br><span class="accent">Share what it earns.</span></h2>
      <p>If you coach runners, your method can live in here under your name, with a share of what it earns.</p>
      <p>Runners who want one-to-one come to you, not to us. The app is how they find your work in the first place.</p>
    </div>
    <div class="coaching-coaches-panel">
      <p>You keep {{ coachShare }} of every subscription to your tier. Tell us how you coach and we will set up your workspace.</p>
      <a class="btn-outline" href="mailto:mail@lastsoulultra.com?subject=My%20coaching%20method">mail@lastsoulultra.com</a>
      <a class="coaching-app-link" href="/app/coaches">See the coach tools <span aria-hidden="true">→</span></a>
    </div>
  </section>
</div>

</div>
@endsection
