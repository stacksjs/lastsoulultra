<script server>
import { entrySteps, race, raceState } from '../data/race'
import { longDate } from '../data/site'

const pageTitle = 'enter the lottery - Last Soul Ultra'
const pageDescription = `Entry to Last Soul Ultra is by lottery: ${race.fieldSize} athletes handpicked from everyone who applies. The steps, the deadlines and the fee.`
const canonicalPath = '/lottery'

const state = raceState()

/* Registration closed on this date, and the organiser's own lottery page says
   so. Derived rather than typed so the page cannot claim an open lottery once
   the date has passed. */
const closesOn = '2026-02-15'
const isOpen = Date.now() < new Date(`${closesOn}T23:59:59Z`).getTime()

const conditions = [
  'One entry per person, using your real name.',
  'Entering the lottery is free. The fee is only paid by athletes who are selected.',
  `You must be ${race.minimumAge} or over at the time of registration.`,
  'There are no refunds once an entry fee is paid and the place is confirmed.',
  'Starting spots are non-transferable.',
]
</script>
<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <SiteNav current="/lottery" />

    <main id="main">
      <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
        <header class="pt-12 lg:pt-16 pb-10 border-b rule">
          <p class="label accent">entry</p>
          <h1 class="display text-5xl sm:text-7xl lg:text-8xl ink mt-4 max-w-[13ch]">a place is drawn, then earned.</h1>
          <p class="mt-6 text-base sm:text-lg muted max-w-[58ch] leading-relaxed">
            Anyone may apply. {{ race.fieldSize }} are chosen. Being drawn gets you the right to pay for a number, not the number itself.
          </p>

          {{-- The single most useful thing this page can say is whether it is
            open, so it is said first and derived from the date. --}}
          <div class="mt-9 p-6 border rule surface max-w-2xl">
            @if(isOpen)
              <p class="label accent">the lottery is open</p>
              <p class="mt-3 text-lg ink">Registrations are collected until {{ longDate(closesOn) }}.</p>
            @else
              <p class="label faint">the lottery is closed</p>
              <p class="mt-3 text-lg ink">Registration closed on {{ longDate(closesOn) }}, and the field for {{ longDate(race.startsOn) }} has been picked.</p>
              @if(state === 'running')
                <p class="mt-3 text-sm muted">That race is running now. Follow it live while it lasts.</p>
                <a class="btn btn-accent mt-6" href="{{ race.liveResults }}" target="_blank" rel="noopener">live results</a>
              @else
                <p class="mt-3 text-sm muted">The next edition is announced on Instagram and to anyone who has written in.</p>
                <a class="btn btn-outline mt-6" href="{{ race.instagram }}" target="_blank" rel="noopener">follow for the next one</a>
              @endif
            @endif
          </div>
        </header>
      </div>

      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20">
          <h2 class="display text-4xl sm:text-5xl ink mb-10 reveal-item">how it works.</h2>
          <ol class="divide-y rule border-t rule">
            @foreach(entrySteps as step)
              <li class="grid sm:grid-cols-12 gap-4 sm:gap-8 py-8 reveal-item">
                <h3 class="sm:col-span-4 display text-xl lg:text-2xl ink">{{ step.title }}</h3>
                <p class="sm:col-span-5 text-sm muted leading-relaxed">{{ step.detail }}</p>
                <p class="sm:col-span-3 label accent sm:text-right">{{ step.deadline ?? '' }}</p>
              </li>
            @endforeach
          </ol>
        </div>
      </section>

      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-12 gap-x-14 gap-y-10">
          <div class="lg:col-span-5 reveal-item">
            <h2 class="display text-3xl sm:text-4xl ink">the conditions.</h2>
            <p class="mt-4 text-sm muted leading-relaxed max-w-[42ch]">
              Short, and worth reading before you enter rather than after you are selected.
            </p>
          </div>
          <ul class="lg:col-span-7 space-y-4 reveal-item">
            @foreach(conditions as condition)
              <li class="flex gap-4 text-sm muted leading-relaxed border-b rule pb-4">
                <span class="w-1.5 h-1.5 accent-bg mt-2 shrink-0" aria-hidden="true"></span>
                {{ condition }}
              </li>
            @endforeach
          </ul>
        </div>
      </section>

      <section data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20 reveal-item">
          <h2 class="display text-3xl sm:text-4xl ink">still have questions?</h2>
          <p class="mt-4 text-base muted max-w-[52ch] leading-relaxed">
            Write to <a class="ink underlink" href="mailto:{{ race.email }}">{{ race.email }}</a>. Replies can take up to {{ race.replyWithinHours }} hours.
          </p>
          <div class="flex flex-wrap gap-3 mt-8">
            <a class="btn btn-outline" href="/faq">read the faq first</a>
            <a class="btn btn-outline" href="/contact">contact</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
