@extends('layouts/LSU')
@section('content')
<script server>
import { productionPages } from '~/resources/data/production-pages'
import { entryHeading, entryKicker, entryRows, raceEvents } from '~/resources/data/race-events'
const currentPage = productionPages["/lottery"]
const canonicalPath = "/lottery"

/* The windows, from the service that owns them. Stating them in markup was
   true on the day it was typed: the USA window closes on 1 November 2026 and
   the UK opens on 31 October, so this page would have been wrong about both
   within a week. The seed below is what a reader sees before the first poll;
   a static build freezes it, so the client refuses a stale one. */
const entrySeed = await raceEvents()
const entrySeedRows = entryRows(entrySeed)
const entrySeedHeading = entryHeading(entrySeed)
const entrySeedKicker = entryKicker(entrySeed)
</script>
<script client>
const LSU_ENTRY_SEED_MAX_AGE = 600000
const lsuEntryFresh = Boolean(entrySeed.ok && entrySeed.fetchedAt && Date.now() - entrySeed.fetchedAt < LSU_ENTRY_SEED_MAX_AGE)
const lsuEntryRows = state(lsuEntryFresh ? entrySeedRows : [])
const lsuEntryHeading = state(lsuEntryFresh ? entrySeedHeading : '')
const lsuEntryKicker = state(lsuEntryFresh ? entrySeedKicker : '')

async function lsuReadEntries() {
  try {
    const payload = await (await fetch('/api/events', { headers: { accept: 'application/json' } })).json()
    // Already shaped by the same code the server render used.
    if (!payload || !payload.ok || !Array.isArray(payload.rows)) return
    lsuEntryRows.set(payload.rows)
    lsuEntryHeading.set(payload.heading || '')
    lsuEntryKicker.set(payload.kicker || '')
  }
  catch {
    // Leave the seeded windows up rather than blanking the section.
  }
}
onMount(() => { lsuReadEntries() })
</script>
<section class="lsu-scope-lottery phero">
<div class="lsu-scope-lottery phero-copy">
<div class="kicker lsu-scope-lottery" :text="lsuEntryKicker()"></div>
<h1 class="lsu-scope-lottery">Request a race entry</h1>
<p class="lsu-scope-lottery">Submit an entry request for an open event. Sending a request does not guarantee a place. Places are selected by the LSU team. We will email you with the next steps if you are selected. Know <a href="/format">what a backyard ultra asks of you</a> before you do.</p>
</div>
</section>
<section id="form" class="entry lsu-scope-lottery">
<div class="entry-shell lsu-scope-lottery">
<RacePortal />
</div>
</section>
<section class="lsu-scope-lottery open-now section" :if="lsuEntryRows().length">
<div class="lsu-scope-lottery shell">
<h2 class="h2-sm lsu-scope-lottery" :text="lsuEntryHeading()"></h2>
<div class="lsu-scope-lottery open-list">
<article :for="row in lsuEntryRows()" class="lsu-scope-lottery">
<h3 class="lsu-scope-lottery"><span :text="row.name"></span> <span class="lsu-scope-lottery" :text="row.when"></span></h3>
<p class="lsu-scope-lottery open-status" :class="row.open ? 'is-open' : ''">
<span :text="row.label"></span>
<a :if="row.isFinal" href="/world-series#qualify" class="lsu-scope-lottery"> · How to qualify</a>
</p>
</article>
</div>
</div>
</section>
<section class="lsu-scope-lottery section">
<div class="lsu-scope-lottery steps-shell">
<h2 class="h2 lsu-scope-lottery steps-title">How a race entry works</h2>
<div class="lsu-scope-lottery steps">
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">01</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Use your real name</div>
<div class="lsu-scope-lottery step-body">Fill out the form with your real name. One request per person only, under <a href="/terms">the terms of entry</a>.</div>
</div>
</div>
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">02</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Wait for the close</div>
<div class="lsu-scope-lottery step-body">Each event shows its closing date on the entry form, in your own time zone.</div>
</div>
</div>
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">03</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Athletes are selected</div>
<div class="lsu-scope-lottery step-body">Places are selected by the LSU team. If you are selected, we email you with the next steps.</div>
</div>
</div>
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">04</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Confirm your place</div>
<div class="lsu-scope-lottery step-body">Within seven days, on your profile: sign the participant agreement and pay the entry fee. A free place only needs the signature.</div>
</div>
</div>
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">05</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Confirmation email</div>
<div class="lsu-scope-lottery step-body">Once your place is confirmed you receive a confirmation email.</div>
</div>
</div>
<div class="lsu-scope-lottery step">
<div class="lsu-scope-lottery step-n">06</div>
<div class="lsu-scope-lottery step-copy">
<div class="lsu-scope-lottery step-title">Your spot is secured</div>
<div class="lsu-scope-lottery step-body">If you have that email, you are on the start line. Good luck.</div>
</div>
</div>
</div>
</div>
</section>
<section class="band deadline lsu-scope-lottery">
<div class="band-bg lsu-scope-lottery" style="background-image:url(&#x27;/assets/lsu/images/rappid-31.webp&#x27;);background-position:center 45%" data-px="0.26">
</div>
<div class="band-scrim lsu-scope-lottery">
</div>
<div class="band-copy lsu-scope-lottery" data-px="-0.1">
<p class="lsu-scope-lottery"> One request per person. <span class="accent lsu-scope-lottery">No guarantee of a place.</span>
<br class="lsu-scope-lottery">Places are selected by the LSU team. </p>
</div>
</section>
@endsection
