<script server>
import { groupBySlug } from '../data/faq'
import { at, shots } from '../data/media'
import { field, race, rules } from '../data/race'
import { socialImage, socialImageAlt, siteOrigin } from '../data/site'

const pageTitle = 'the format - Last Soul Ultra'
const pageDescription = 'A 6.7 km loop, every hour, on the hour, until one runner is left. The backyard ultra format explained, plus the gear and camp rules.'
const canonicalPath = '/format'

const raceGroup = groupBySlug('the-race')
const crewGroup = groupBySlug('crew')

/* The rules that end a race, pulled out of the FAQ because they are the two
   things most likely to catch a first-time entrant. */
const disqualifiers = [
  { title: 'support on the course', detail: 'Any assistance once the athlete has entered the loop, down to handing over a gel, is an immediate disqualification.' },
  { title: 'crew on the track', detail: 'Crew members are not allowed on the course at all. If it happens, the athlete they are crewing is out.' },
  { title: 'no headlamp after dark', detail: 'A working headlamp is mandatory in twilight and darkness. Without one you do not start the loop.' },
]
</script>
<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <SiteNav current="/format" />

    <main id="main">
      <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
        <header class="pt-12 lg:pt-16 pb-10 border-b rule">
          <p class="label accent">the format</p>
          <h1 class="display h-page ink mt-4 max-w-[14ch]">one loop. every hour. forever.</h1>
          <p class="mt-6 text-base sm:text-lg muted max-w-[58ch] leading-relaxed">
            A backyard ultra has no distance and no cut-off, which makes it sound easier than a marathon and is why it is not. The rules fit on a postcard; surviving them does not.
          </p>
        </header>
      </div>

      {{-- The four constants, given the space they deserve. --}}
      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 divide-y rule">
          @foreach(rules as rule)
            <div class="grid sm:grid-cols-12 gap-4 sm:gap-8 py-8 lg:py-10 reveal-item">
              <p class="sm:col-span-3 label faint pt-2">{{ rule.label }}</p>
              <p class="sm:col-span-4 display h-stat accent">{{ rule.value }}</p>
              <p class="sm:col-span-5 text-sm muted leading-relaxed">{{ rule.detail }}</p>
            </div>
          @endforeach
        </div>
      </section>

      {{-- The arithmetic that makes it hard, against the night frame. --}}
      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto grid lg:grid-cols-12 items-stretch">
          <div class="lg:col-span-6 order-2 lg:order-1 px-5 lg:px-8 py-14 lg:py-20 flex flex-col justify-center reveal-item">
            <h2 class="display h-lead ink max-w-[16ch]">the rest is the race.</h2>
            <p class="mt-6 text-base muted leading-relaxed max-w-[52ch]">
              The loop is the easy part. What decides a backyard ultra is the gap between finishing one and starting the next, because that gap is whatever you have left of the hour.
            </p>
            <dl class="grid grid-cols-3 gap-6 mt-10 pt-8 border-t rule max-w-lg">
              <div>
                <dt class="label faint">a 40 min loop</dt>
                <dd class="display text-3xl accent mt-2">20<span class="text-base ml-1">min</span></dd>
              </div>
              <div>
                <dt class="label faint">a 50 min loop</dt>
                <dd class="display text-3xl accent mt-2">10<span class="text-base ml-1">min</span></dd>
              </div>
              <div>
                <dt class="label faint">a 58 min loop</dt>
                <dd class="display text-3xl accent mt-2">2<span class="text-base ml-1">min</span></dd>
              </div>
            </dl>
            <p class="mt-5 text-sm faint max-w-[46ch]">Time left to eat, change, treat your feet and sleep, before the next start.</p>
          </div>

          <div class="lg:col-span-6 order-1 lg:order-2 border-l-0 lg:border-l rule reveal-item">
            <div class="relative h-full min-h-[280px] aspect-[4/3] lg:aspect-auto overflow-hidden surface">
              <img
                class="absolute inset-0 w-full h-full object-cover"
                src="{{ at(shots.refuel, 1200) }}"
                alt="{{ shots.refuel.alt }}"
                width="1200"
                height="1500"
                loading="lazy"
                decoding="async"
              >
            </div>
          </div>
        </div>
      </section>

      {{-- What ends a race, stated plainly rather than buried in an FAQ. --}}
      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20">
          <h2 class="display h-sect ink mb-10 reveal-item">three ways to <span class="whitespace-nowrap">be out.</span></h2>
          <div class="grid sm:grid-cols-3 gap-x-8 gap-y-10">
            @foreach(disqualifiers as item)
              <div class="reveal-item border-t rule-strong pt-5">
                <h3 class="display h-item ink">{{ item.title }}</h3>
                <p class="mt-3 text-sm muted leading-relaxed">{{ item.detail }}</p>
              </div>
            @endforeach
          </div>
          <p class="mt-10 text-sm faint max-w-[60ch] reveal-item">
            Alongside the obvious one: not completing the loop inside the hour, or not starting the next.
          </p>
        </div>
      </section>

      {{-- Camp and provisions: the practical half. --}}
      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-2 gap-x-14 gap-y-10">
          <div class="reveal-item">
            <p class="label accent">base camp</p>
            <h2 class="display h-sect ink mt-3">{{ race.campSizeMetres }} x {{ race.campSizeMetres }} metres, yours.</h2>
            <p class="mt-5 text-sm muted leading-relaxed max-w-[46ch]">
              Marked in advance and assigned first come, first served. As runners drop out, the remaining camps may be moved closer to the starting line.
            </p>
            <p class="mt-4 text-sm muted leading-relaxed max-w-[46ch]">
              Up to {{ race.crewMax }} crew members may work on you here, and having a crew is optional rather than expected.
            </p>
          </div>
          <div class="reveal-item">
            <p class="label accent">what is provided</p>
            <h2 class="display h-sect ink mt-3">water. that is <span class="whitespace-nowrap">close to it.</span></h2>
            <p class="mt-5 text-sm muted leading-relaxed max-w-[46ch]">
              Water is provided in containers for each athlete. There is no electrical hookup, and full catering is not provided: every participant manages their own nutrition.
            </p>
            <p class="mt-4 text-sm muted leading-relaxed max-w-[46ch]">
              An aid station at base camp is stocked throughout, but it supplements self-sufficiency rather than replacing it.
            </p>
          </div>
        </div>
      </section>

      <section class="accent-bg" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20 flex flex-col lg:flex-row lg:items-end justify-between gap-8 reveal-item">
          <div>
            <h2 class="display h-lead max-w-[16ch]">still want a number?</h2>
            <p class="mt-4 text-base max-w-[48ch] leading-relaxed ink-on-accent-soft">{{ field }}</p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a class="btn" style="background: var(--page); color: var(--ink); border-color: var(--page)" href="/lottery">how to enter</a>
            <a class="btn" style="border-color: currentColor" href="/faq">read the faq</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
