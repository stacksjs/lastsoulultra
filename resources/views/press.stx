<script server>
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/press"]
const canonicalPath = "/press"
const logo = '/assets/lsu/images/lsu-logo.svg'
const donts = [
  { kind: 'stretch', label: 'Stretch or squash it' },
  { kind: 'rotate', label: 'Rotate it' },
  { kind: 'recolour', label: 'Recolour it' },
  { kind: 'shadow', label: 'Add outlines or shadows' },
  { kind: 'bright', label: 'Put it on a bright photo without a scrim' },
]
const photos = [
  { preview: 'recap-02', file: 'lsu-photo-01.jpg', alt: 'A black-and-white portrait of a runner in a bandana and face covering, arms crossed.' },
  { preview: 'recap-05', file: 'lsu-photo-02.jpg', alt: 'A group of runners with their arms round each other in the sun, bags at their feet.' },
  { preview: 'recap-08', file: 'lsu-photo-03.jpg', alt: 'A smiling runner under the start arch, in black and white.' },
  { preview: 'recap-11', file: 'lsu-photo-04.jpg', alt: 'A runner seen from behind under the red LOOP 88 clock.' },
]
</script>
