  </div>
</section>

<section class="section" id="logo">
  <div class="shell">
    <h2 class="h2">The logo</h2>
    <p class="press-lead">The italic LSU is our only mark. There is no separate wordmark. Use white on dark, black on light.</p>
    <div class="logo-grid">
      <figure class="dark logo-tile">
        <img src="/press/logo/lsu-logo-white.svg" alt="Last Soul Ultra logo in white" width="877" height="177">
        <figcaption><span>White · for black and dark photos</span><span class="dl"><a href="/press/logo/lsu-logo-white.svg" download>SVG</a><a href="/press/logo/lsu-logo-white.png" download>PNG 2400px</a></span></figcaption>
      </figure>
      <figure class="light logo-tile">
        <img src="/press/logo/lsu-logo-black.svg" alt="Last Soul Ultra logo in black" width="877" height="177">
        <figcaption><span>Black · for white and light surfaces</span><span class="dl"><a href="/press/logo/lsu-logo-black.svg" download>SVG</a><a href="/press/logo/lsu-logo-black.png" download>PNG 2400px</a></span></figcaption>
      </figure>
      <figure class="logo-tile square">
        <div class="tile-box"><img src="{{ logo }}" alt="Last Soul Ultra square avatar" width="877" height="177"></div>
        <figcaption><span>Square tile · social avatar</span><span class="dl"><a href="/press/logo/lsu-logo-tile.png" download>PNG 1024px</a></span></figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section tint" id="usage">
  <div class="shell">
    <h2 class="h2">Using the logo</h2>
    <div class="usage-grid">
      <div class="rule">
        <div class="clear-demo" aria-hidden="true"><div class="clear-box"><img src="{{ logo }}" alt="" width="877" height="177"></div></div>
        <h3 class="h2-sm">Clear space</h3>
        <p>Leave at least the mark's own height clear on every side. Nothing else sits inside that box.</p>
      </div>
      <div class="rule">
        <div class="min-demo" aria-hidden="true"><img src="{{ logo }}" alt="" width="877" height="177"><span class="label">120 px · 30 mm</span></div>
        <h3 class="h2-sm">Minimum size</h3>
        <p>Never narrower than 120 px on screen or 30 mm in print. The SVG scales to any size above that.</p>
      </div>
    </div>
    <h3 class="donts-head h2-sm">Don't</h3>
    <ul class="donts">
      @foreach(donts as dont)
      <li><div class="dont-demo {{ dont.kind }}" aria-hidden="true"><img src="{{ logo }}" alt="" width="877" height="177"></div><span>{{ dont.label }}</span></li>
      @endforeach
    </ul>
  </div>
</section>

<section class="section" id="colour">
  <div class="shell">
