@extends('layouts/LSU')
@section('content')
<script server>
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/results/last-soul-ultra-2025"]
const canonicalPath = "/results/last-soul-ultra-2025"
</script>
<script client>
import rrSource from '../../data/results-2025.json'
const rrQuery = state('')
const rrCategory = state('all')
const rrSort = state('rank')
const rrYard = state(1)
const rrNames = rrSource.results.map(row => row.name.toLowerCase()).sort((a, b) => a.localeCompare(b))
function rrMatch(name, bib, category) { return (rrCategory() === 'all' || rrCategory() === category) && (!rrQuery().trim() || (name + ' ' + bib).toLowerCase().includes(rrQuery().trim().toLowerCase())) }
function rrOrder(name, bib, rank) { return rrSort() === 'name' ? rrNames.indexOf(name) : rrSort() === 'bib' ? Number(bib) : Number(rank) }
const rrCount = derived(() => rrSource.results.filter(row => rrMatch(row.name, row.bib, row.category)).length)
const rrYardCount = derived(() => rrSource.results.filter(row => Number(row.yards) >= rrYard()).length)
</script>

