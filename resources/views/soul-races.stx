@extends('layouts/LSU')
@section('content')
<script server>
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/soul-races"]
const canonicalPath = "/soul-races"
</script>
<script client>
import { formValues } from '../functions/race-api'
const srHostOpen = state(false)
const srDone = state(false)
const srBusy = state(false)
const srError = state('')
const srEmail = state('')
const srRaces = state([])
const srRegion = state('')
const srStatus = state('')
const srQual = state('')
const srQuery = state('')
const srFiltered = derived(() => srRaces().filter(race => (!srRegion() || (race.region || race.continent) === srRegion()) && (!srStatus() || race.status === srStatus()) && (!srQual() || srQual() === 'all' || Number(race.qualifier_spots) > 0) && (!srQuery().trim() || [race.name, race.city, race.country_code, race.host].join(' ').toLowerCase().includes(srQuery().trim().toLowerCase()))))
async function srSubmit(event) {
  if (srBusy()) return
  srBusy.set(true)
  srError.set('')
  try {
    const form = formValues(event)
    const parts = String(form.coordinates || '').split(',').map(value => Number(value.trim()))
    if (parts.length !== 2 || !parts.every(Number.isFinite) || Math.abs(parts[0]) > 90 || Math.abs(parts[1]) > 180) throw new Error('Paste the latitude and longitude, separated by a comma.')
    const body = { ...form, lat: parts[0], lng: parts[1], capacity: form.capacity ? Number(form.capacity) : null }
    delete body.coordinates
    const result = await fetch('https://api.lastsoulultra.com/v1/soul-races/applications', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) })
    const data = await result.json()
    if (result.status !== 201) throw new Error(result.status === 429 ? 'Too many attempts. Wait a minute and try again.' : data?.error?.message || data?.message || 'Your application could not be submitted.')
    srEmail.set(String(form.contact_email))
    srDone.set(true)
  }
  catch (error) { srError.set(error.message || 'Check your connection and try again.') }
  finally { srBusy.set(false) }
}
onMount(async () => {
  try {
    const response = await fetch('https://api.lastsoulultra.com/v1/soul-races')
    if (!response.ok) throw new Error('Could not load Soul Races')
    srRaces.set(await response.json())
  }
  catch (error) { srError.set(error.message) }
})
</script>

<section class="lsu-scope-soul-races phero">
<header class="lsu-scope-soul-races phero-copy sr-head">
<h1 class="lsu-scope-soul-races">
<span class="kicker lsu-scope-soul-races">Affiliate backyard races</span>Soul Races<br class="lsu-scope-soul-races">
<span class="accent lsu-scope-soul-races">around the world</span>
</h1>
<p class="lsu-scope-soul-races sr-lead">Independent backyard ultras that run our format and carry our name. Find one near you, check the date, and enter on the organiser’s own site.</p>
<p class="lsu-scope-soul-races sr-note">Entries, prices and refunds are handled by each race, not by us.</p>
<dl class="lsu-scope-soul-races sr-counts">
<div class="lsu-scope-soul-races">
<dd :text="srRaces.length" data-count-races class="lsu-scope-soul-races">0</dd>
<dt class="lsu-scope-soul-races">Races listed</dt>
</div>
<div class="lsu-scope-soul-races">
<dd data-count-countries class="lsu-scope-soul-races">0</dd>
<dt class="lsu-scope-soul-races">Countries</dt>
</div>
<div class="lsu-scope-soul-races">
<dd data-count-open class="lsu-scope-soul-races">0</dd>
<dt class="lsu-scope-soul-races">Entries open</dt>
</div>
<div class="lsu-scope-soul-races">
<dd data-count-qual class="lsu-scope-soul-races">0</dd>
<dt class="lsu-scope-soul-races">With qualifier spots</dt>
</div>
</dl>
</header>
</section>
<div class="lsu-scope-soul-races sr-body">
<div class="lsu-scope-soul-races sr-filters" role="search">
<label class="lsu-scope-soul-races">Region<select x-model="srRegion" data-filter-region class="lsu-scope-soul-races">
<option value="" class="lsu-scope-soul-races">All regions</option>
<option class="lsu-scope-soul-races">Europe</option>
<option class="lsu-scope-soul-races">North America</option>
<option class="lsu-scope-soul-races">South America</option>
<option class="lsu-scope-soul-races">Africa</option>
<option class="lsu-scope-soul-races">Asia</option>
<option class="lsu-scope-soul-races">Oceania</option>
</select>
</label>
<label class="lsu-scope-soul-races">Status<select x-model="srStatus" data-filter-status class="lsu-scope-soul-races">
<option value="" class="lsu-scope-soul-races">Any status</option>
<option value="open" class="lsu-scope-soul-races">Entry open</option>
<option value="waitlist" class="lsu-scope-soul-races">Waitlist</option>
<option value="full" class="lsu-scope-soul-races">Sold out</option>
<option value="announced" class="lsu-scope-soul-races">Announced</option>
<option value="past" class="lsu-scope-soul-races">Past editions</option>
</select>
</label>
<label class="lsu-scope-soul-races">Qualification<select x-model="srQual" data-filter-qual class="lsu-scope-soul-races">
<option value="" class="lsu-scope-soul-races">All races</option>
<option value="only" class="lsu-scope-soul-races">With qualifier spots</option>
</select>
</label>
<label class="lsu-scope-soul-races">Search<input type="search" x-model="srQuery" data-filter-q placeholder="Race, city, country" autocomplete="off" class="lsu-scope-soul-races">
</label>
</div>
<div class="lsu-scope-soul-races sr-stage">
<section class="lsu-scope-soul-races sr-map" aria-label="Soul Races on the world map" style="aspect-ratio:1.9043">
<img class="lsu-scope-soul-races sr-land" src="/assets/lsu/data/world-landmask.png" alt="" aria-hidden="true">
<svg class="lsu-scope-soul-races sr-overlay" viewbox="0 0 1000 525" preserveaspectratio="xMidYMid meet" role="group" aria-label="Soul Races on the world map">
<g data-markers class="lsu-scope-soul-races">
</g>
</svg>
<div class="lsu-scope-soul-races sr-tip" data-tip hidden>
</div>
<p class="lsu-scope-soul-races sr-hint" aria-hidden="true">Select a pin for the race</p>
</section>
<div class="lsu-scope-soul-races sr-side">
<p class="lsu-scope-soul-races sr-result-count" :text="srFiltered.length + ' races'" data-result-count aria-live="polite">0 races</p>
<section class="lsu-scope-soul-races sr-list" data-list aria-label="Soul Races">
<p :if="!srRaces.length" class="lsu-scope-soul-races sr-empty">No Soul Races are listed yet. Be the first.</p>
<p :if="srRaces.length && !srFiltered.length" class="lsu-scope-soul-races sr-empty">No Soul Races match your search.</p>
<article :for="race in srFiltered" class="lsu-scope-soul-races sr-card"><h2 :text="race.name" class="lsu-scope-soul-races"></h2><p :text="race.city + ', ' + race.country_code" class="lsu-scope-soul-races"></p><p :text="race.summary" class="lsu-scope-soul-races"></p><a :href="race.registration_url" rel="noopener" class="lsu-scope-soul-races">View race and entry details</a></article>
</section>
</div>
</div>
<section class="lsu-scope-soul-races sr-host">
<div class="lsu-scope-soul-races">
<h2 class="lsu-scope-soul-races">Want your race to become a Soul Race?</h2>
<p class="lsu-scope-soul-races">You keep your race, your entries and your money. You run our format, use the Soul Race name and get listed here, and your best runners can earn a place at the Last Soul Ultra.</p>
<button type="button" class="btn lsu-scope-soul-races" @click="srHostOpen.set(true)" data-host-open>Apply to host</button>
</div>
<div class="lsu-scope-soul-races">
<h2 class="lsu-scope-soul-races">How entries work</h2>
<p class="lsu-scope-soul-races">Every Soul Race handles its own entries. We list the race, the date and the link; the button takes you straight to the organiser’s registration. Prices, refunds and race rules are theirs.</p>
</div>
</section>
</div>
<Dialog className="lsu-host-dialog" :open="srHostOpen" @close="srHostOpen.set(false)" title="Apply to host a Soul Race"><DialogBackdrop /><DialogPanel flush="true" className="lsu-scope-soul-races sr-dialog">
<div class="lsu-scope-soul-races sr-dialog-bar">
