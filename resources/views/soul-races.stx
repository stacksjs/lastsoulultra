<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="city">Town or city *<input name="city" required maxlength="120" autocomplete="address-level2" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field field-wide lsu-scope-soul-races" data-field="coordinates">Start line coordinates *<input name="coordinates" required inputmode="decimal" placeholder="51.4818, 7.2162" autocomplete="off" class="lsu-scope-soul-races">
<span class="hint lsu-scope-soul-races">In Google Maps, right-click the start line and click the numbers at the top to copy them, e.g. 51.4818, 7.2162.</span>
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="date">Race date<input type="date" name="date" class="lsu-scope-soul-races">
<span class="hint lsu-scope-soul-races">Leave empty if it is not set yet.</span>
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="status">Entries<select name="status" class="lsu-scope-soul-races">
<option value="announced" class="lsu-scope-soul-races">Announced</option>
<option value="open" class="lsu-scope-soul-races">Entry open</option>
<option value="waitlist" class="lsu-scope-soul-races">Waitlist</option>
<option value="full" class="lsu-scope-soul-races">Sold out</option>
</select>
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="capacity">Runner cap<input type="number" name="capacity" min="1" max="10000" inputmode="numeric" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="price_from">Entry fee from<input name="price_from" maxlength="40" placeholder="e.g. 45 €" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field field-wide lsu-scope-soul-races" data-field="registration_url">Registration page<input type="url" name="registration_url" placeholder="https://" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="website_url">Race website<input type="url" name="website_url" placeholder="https://" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="instagram_url">Instagram<input type="url" name="instagram_url" placeholder="https://instagram.com/…" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field field-wide lsu-scope-soul-races" data-field="summary">About the race *<textarea name="summary" required maxlength="600" rows="3" class="lsu-scope-soul-races">
</textarea>
<span class="hint lsu-scope-soul-races">One or two sentences for the listing: the loop, the terrain, what makes it yours.</span>
<small class="lsu-scope-soul-races">
</small>
</label>
</fieldset>
<fieldset class="lsu-scope-soul-races">
<legend class="lsu-scope-soul-races">You</legend>
<label class="field lsu-scope-soul-races" data-field="contact_name">Your name *<input name="contact_name" required maxlength="120" autocomplete="name" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="contact_email">Email *<input type="email" name="contact_email" required autocomplete="email" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field lsu-scope-soul-races" data-field="contact_phone">Phone<input type="tel" name="contact_phone" maxlength="40" autocomplete="tel" class="lsu-scope-soul-races">
<small class="lsu-scope-soul-races">
</small>
</label>
<label class="field field-wide lsu-scope-soul-races" data-field="notes">Anything else we should know<textarea name="notes" maxlength="4000" rows="4" class="lsu-scope-soul-races">
</textarea>
<span class="hint lsu-scope-soul-races">Your backyard experience, past editions, questions. Not published.</span>
<small class="lsu-scope-soul-races">
</small>
</label>
</fieldset>
<label class="lsu-scope-soul-races sr-trap" aria-hidden="true">Fax<input name="fax" tabindex="-1" autocomplete="off" class="lsu-scope-soul-races">
</label>
<p class="lsu-scope-soul-races sr-privacy">We use these details only to review your application and to write to you about it. See our <a href="/privacy">privacy policy</a>.</p>
<p class="lsu-scope-soul-races sr-form-status" :text="srError" data-form-status role="alert">
</p>
<button type="submit" :disabled="srBusy" class="btn lsu-scope-soul-races">Send application</button>
</form>
<div class="lsu-scope-soul-races sr-done" :if="srDone" data-host-done>
<h3 class="lsu-scope-soul-races">Application received</h3>
<p class="lsu-scope-soul-races">Thank you. We will review your race and reply to <strong :text="srEmail" data-done-email class="lsu-scope-soul-races">
</strong>.</p>
<button type="button" class="btn lsu-scope-soul-races" @click="srHostOpen.set(false)" data-host-close>Close</button>
</div>
</DialogPanel></Dialog>
@endsection
