<script server>
import { at, shots } from '../data/media'
import { race } from '../data/race'

const pageTitle = 'sponsorship - Last Soul Ultra'
const pageDescription = 'A small number of partners, integrated into a race format that runs long after race day: on-site presence, the 24/7 livestream and documentary content.'
const canonicalPath = '/sponsorship'

/* The touchpoints the organiser names, given the structure a brand actually
   evaluates them with rather than left as one paragraph. */
const touchpoints = [
  { title: 'on site', detail: 'Presence at the base camp and the corral, where the field and its crews spend every hour they are not running.' },
  { title: 'the livestream', detail: 'A 24/7 broadcast from the gun until the final solo loop, running as long as the last runner does.' },
  { title: 'the documentary', detail: 'Long-form storytelling published after the event, which is where a backyard ultra does most of its reach.' },
]
</script>
<!DOCTYPE html>
<html lang="en">
  <head>@include('head')</head>
  <body>
    <SiteNav current="/sponsorship" />

    <main id="main">
      <div class="max-w-[1500px] mx-auto px-5 lg:px-8">
        <header class="pt-12 lg:pt-16 pb-10 border-b rule">
          <p class="label accent">partners</p>
          <h1 class="display h-page ink mt-4 max-w-[14ch]">a few brands. not a hoarding.</h1>
          <p class="mt-6 text-base sm:text-lg muted max-w-[58ch] leading-relaxed">
            We work with a small number of carefully selected partners who share the vision and values behind the event, and who are integrated in a natural and meaningful way.
          </p>
        </header>
      </div>

      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto px-5 lg:px-8 py-14 lg:py-20">
          <h2 class="display h-sect ink mb-10 reveal-item">where a partner shows up.</h2>
          <div class="grid sm:grid-cols-3 gap-x-8 gap-y-10">
            @foreach(touchpoints as point)
              <div class="reveal-item border-t rule-strong pt-5">
                <h3 class="display h-item ink">{{ point.title }}</h3>
                <p class="mt-3 text-sm muted leading-relaxed">{{ point.detail }}</p>
              </div>
            @endforeach
          </div>
        </div>
      </section>

      <section class="border-b rule" data-reveal>
        <div class="max-w-[1500px] mx-auto grid lg:grid-cols-12 items-stretch">
          <div class="lg:col-span-6 reveal-item">
            <div class="relative h-full min-h-[280px] aspect-[4/3] lg:aspect-auto overflow-hidden surface">
              <img
                class="absolute inset-0 w-full h-full object-cover"
                src="{{ at(shots.night, 1200) }}"
                alt="{{ shots.night.alt }}"
                width="1200"
                height="1500"
                loading="lazy"
                decoding="async"
              >
            </div>
          </div>
          <div class="lg:col-span-6 px-5 lg:px-8 py-14 lg:py-20 flex flex-col justify-center border-l-0 lg:border-l rule reveal-item">
            <h2 class="display h-lead ink max-w-[18ch]">the story outlasts the race.</h2>
            <p class="mt-6 text-base muted leading-relaxed max-w-[50ch]">
              Last Soul Ultra is built around long-term storytelling that goes far beyond race day. A format with no finish line produces something to watch for as long as somebody is still running, and something to publish long after they stop.
            </p>
            <p class="mt-4 text-base muted leading-relaxed max-w-[50ch]">
              If you think your brand could be the right fit and you share the vision behind the event, get in touch.
            </p>
            <a class="btn btn-accent mt-9 self-start" href="mailto:{{ race.email }}?subject=Sponsorship">let&rsquo;s talk</a>
