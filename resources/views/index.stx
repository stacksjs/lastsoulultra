@extends('layouts/LSU')
@section('content')
<script server>
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/"]
const canonicalPath = "/"
</script>
<script client>
import { moveGallery, galleryPosition, seekRaceVideo, storyProgress } from '../functions/site-interactions'
import raceStory from '../data/race-story.json'
import { useScroll, useMediaQuery } from '@stacksjs/composables'
const lsuYardVideo = useRef('lsuYardVideo')
const lsuScroll = useScroll(undefined, { throttle: 32 })
const lsuReducedMotion = useMediaQuery('(prefers-reduced-motion: reduce)')
const lsuBoardSection = useRef('lsuBoardSection')
const lsuDuelSection = useRef('lsuDuelSection')
const lsuLap = state(94)
const lsuDuel = state(94)
const lsuFirstYards = derived(() => Math.min(raceStory['2025'].maxYards, lsuDuel()))
const lsuSouls = derived(() => raceStory['2026'].startersByYard[Math.max(0, lsuLap() - 1)] || 1)
function lsuSeekVideo() {
  if (lsuReducedMotion.value) return
  seekRaceVideo(lsuYardVideo.current)
  lsuLap.set(Math.max(1, Math.round(storyProgress(lsuBoardSection.current) * raceStory['2026'].maxYards)))
  lsuDuel.set(Math.max(1, Math.round(storyProgress(lsuDuelSection.current) * raceStory['2026'].maxYards)))
}
watch(() => lsuScroll.y.value, lsuSeekVideo)
const lsuGallery = useRef('lsuGallery')
const lsuGalleryCount = state(1)
const lsuGalleryPrevious = state(false)
const lsuGalleryNext = state(true)
function lsuGalleryChanged() {
  const position = galleryPosition(lsuGallery.current)
  lsuGalleryCount.set(position.count)
  lsuGalleryPrevious.set(position.previous)
  lsuGalleryNext.set(position.next)
}
function lsuGalleryMove(direction) { moveGallery(lsuGallery.current, direction) }
onMount(() => { lsuGalleryChanged(); lsuSeekVideo() })
</script>

<script client>
import { nextLoop } from '../functions/site-interactions'
const lsuNextLoop = state(nextLoop())
const lsuLoopClock = useInterval(() => lsuNextLoop.set(nextLoop()), 1000)
onDestroy(() => lsuLoopClock.pause())
</script>

