<div class="duel-kicker kicker lsu-scope-home">Season against season</div>
<h2 class="duel-title h2 lsu-scope-home">The race keeps<br class="lsu-scope-home">getting longer</h2>
<div class="duel-bars lsu-scope-home">
<div class="lsu-scope-home">
<div class="duel-head lsu-scope-home">
<span class="duel-id lsu-scope-home">
<span class="duel-ed lsu-scope-home">Season 1 · 2025</span>
<span class="duel-km lsu-scope-home">
<span data-duelkm1 class="lsu-scope-home" :text="(lsuFirstYards * raceStory['2025'].loopMetres / 1000).toFixed(1)">449.3</span>
<span class="duel-unit lsu-scope-home"> km</span>
</span>
</span>
<span class="duel-note lsu-scope-home" data-duelnote1>Kim Gottwald · won at 67 yards</span>
</div>
<div class="duel-track lsu-scope-home">
<div class="duel-fill duel-fill-1 lsu-scope-home" data-duelbar1 :style="'animation:none;transform:none;width:' + (lsuFirstYards / 94 * 100) + '%'">
</div>
<div class="duel-yard duel-yard-1 lsu-scope-home" data-duelyard1 :text="lsuFirstYards">67</div>
</div>
</div>
<div class="lsu-scope-home">
<div class="duel-head lsu-scope-home">
<span class="duel-id lsu-scope-home">
<span class="duel-ed duel-ed-2 lsu-scope-home">Season 2 · 2026</span>
<span class="duel-km duel-km-2 lsu-scope-home">
<span data-duelkm2 class="lsu-scope-home" :text="(lsuDuel * raceStory['2026'].loopMetres / 1000).toFixed(1)">630.4</span>
<span class="duel-unit lsu-scope-home"> km</span>
</span>
</span>
<span class="duel-note lsu-scope-home" data-duelnote2>Mark Dowdle · won at 94 yards</span>
</div>
<div class="duel-track lsu-scope-home">
<div class="duel-fill duel-fill-2 lsu-scope-home" data-duelbar2 :style="'animation:none;transform:none;width:' + (lsuDuel / 94 * 100) + '%'">
</div>
<div class="duel-yard duel-yard-2 lsu-scope-home" data-duelyard2 :text="lsuDuel">94</div>
</div>
</div>
<div class="duel-mark lsu-scope-home">
<div class="duel-mark-label lsu-scope-home">90 · german-soil mark until Season 2</div>
</div>
<p class="duel-text lsu-scope-home" data-dueltext>Scroll. Both fields set off together, hour by hour.</p>
</div>
</div>
</div>
</section>
<section class="attr-band band lsu-scope-home">
<div class="band-bg lsu-scope-home" data-px="0.12">
</div>
<div class="band-scrim lsu-scope-home">
</div>
<div class="band-copy lsu-scope-home" data-px="-0.12">
<p class="attr-copy lsu-scope-home"> Nobody knows how long this takes.<br class="lsu-scope-home">
<span class="accent lsu-scope-home">That is the point.</span>
</p>
</div>
</section>
<section id="enter" class="enter lsu-scope-next-loop">
<div class="enter-bg lsu-scope-next-loop" data-px="0.4">
</div>
<div class="enter-scrim lsu-scope-next-loop">
</div>
<div class="lsu-scope-next-loop phero-ghost" data-px="-0.2">EVENTS</div>
<div class="enter-copy lsu-scope-next-loop" data-px="-0.06">
<div class="kicker lsu-scope-next-loop">The backyard rhythm</div>
<div class="enter-sub lsu-scope-next-loop">Next hour in</div>
<div class="enter-count lsu-scope-next-loop">
<div class="lsu-scope-next-loop seg">
<div class="lsu-scope-next-loop seg-count seg-ghost" aria-hidden="true">88:88</div>
<div class="lsu-scope-next-loop seg-count seg-live" :text="lsuNextLoop" data-nextloop>00:00</div>
</div>
</div>
<h2 class="enter-title lsu-scope-next-loop">Ready to prove your soul?</h2>
<p class="lsu-scope-next-loop">Choose an open event from the <a href="/world-series">2027 World Series schedule</a> and request a race entry with your Last Soul Ultra account.</p>
<a href="/world-series" class="btn btn-lg lsu-scope-next-loop" data-apply data-view-href="/profile">Request a race entry</a>
</div>
</section>
@endsection
