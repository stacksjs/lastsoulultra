@extends('layouts/LSU')
@section('content')
<script server>
import { coachingBrand, coachingOrigin } from '~/resources/functions/coaching-source'
import { productionPages } from '~/resources/data/production-pages'
const currentPage = productionPages["/profile"]
const canonicalPath = "/profile"
const trainingLogin = `${coachingOrigin()}/brands/${coachingBrand()}/login`
</script>
<script client>
const raceAccountOpen = state(false)
onMount(() => {
  const query = useRoute().query || {}
  raceAccountOpen.set(Boolean(query.auth || query.payment || query.event))
})
</script>
<section class="lsu-scope-profile phero">
<div class="lsu-scope-profile phero-copy">
<div class="kicker lsu-scope-profile">Your account</div>
<h1 class="lsu-scope-profile">Profile</h1>
</div>
</section>
<div class="lsu-scope-profile profile-shell">
<section class="account-training" aria-labelledby="training-account-title">
<h2 id="training-account-title">Training &amp; coaching</h2>
<p>Your training plan, workouts, feedback and subscription. Athletes, coaches and administrators sign in here.</p>
<a class="btn" href="{{ trainingLogin }}">Sign in to Training</a>
<a class="account-programs" href="/coaching/plans">Choose a training program</a>
</section>
<details class="account-races" :open="raceAccountOpen">
<summary>Race-entry account</summary>
<p class="account-race-intro">Manage your race applications and entry details with your separate race-entry login.</p>
<RacePortal />
</details>
</div>
@endsection

