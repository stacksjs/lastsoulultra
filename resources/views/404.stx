@extends('layouts/LSU')
@section('content')
<script server>
import { liveRaceState } from '~/resources/data/live'

/* The head partial reads `currentPage`. This page used to declare pageTitle,
   pageDescription and noindex as loose names nothing looked at, so a 404
   served the site's default title and description and invited indexing. */
const currentPage = {
  title: 'not found - Last Soul Ultra',
  description: 'That page is not here.',
  styles: ['/assets/styles/production/base.css', '/assets/styles/production/not-found.css'],
  noindex: true,
}
const canonicalPath = '/404'
const state = await liveRaceState()
</script>
<section class="phero">
  <div class="phero-copy">
    <div class="kicker">404</div>
    <h1>You missed the cut-off.</h1>
    <p>That page is not here. The race, thankfully, still is.</p>
    <div class="not-found-actions">
      <a class="btn" href="/">Back to the start</a>
      @if(state !== 'upcoming')
        <a class="btn-outline" href="/results">{{ state === 'finished' ? 'The result' : 'Live results' }}</a>
      @else
        <a class="btn-outline" href="/format">The format</a>
      @endif
    </div>
  </div>
</section>
@endsection
