<script server>
const demoAccounts = typeof accounts !== 'undefined' && Array.isArray(accounts) ? accounts : []
</script>
@if(demoAccounts.length)
<div class="lsu-demo-credentials" role="region" aria-label="Demo account credentials" tabindex="0">
<table>
<thead><tr><th scope="col">Account</th><th scope="col">Email</th><th scope="col">Password</th></tr></thead>
<tbody>
@foreach(demoAccounts as account)
<tr><th scope="row">{{ account.name }}</th><td><code>{{ account.email }}</code></td><td><code>{{ account.password }}</code></td></tr>
@endforeach
</tbody>
</table>
</div>
@else
<p>The current review logins are available on the password-protected live walkthrough.</p>
@endif
